# Supabase -> Project Settings -> Database -> Connection string -> URI
# MUST be port 5432 (direct/session). Port 6543 is the transaction pooler and
# has no prepared-statement support; the LangGraph checkpointer breaks on it.
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.ywtmxqwshajtdmpfbwiv.supabase.co:5432/postgres

APPROVAL_THRESHOLD_INR=150000
EMERGENCY_BUDGET_INR=500000
MAX_TOOL_CALLS_PER_INCIDENT=12
CLOCK_SECONDS_PER_SIM_HOUR=1

# Phase 4. Gemini only for now - do NOT wire Bedrock.
GEMINI_API_KEY=

# ---- model provider ---------------------------------------------------------
# auto (default) picks whichever key is actually present, preferring production.
# Local testing: set GEMINI_API_KEY and nothing else.
# Production:    set AWS_BEARER_TOKEN_BEDROCK (the ABSK... Bedrock key).
# Force one:     LLM_PROVIDER=gemini | xai | bedrock
LLM_PROVIDER=auto
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# XAI_API_KEY=
# XAI_MODEL=grok-4-fast-non-reasoning
# AWS_BEARER_TOKEN_BEDROCK=   # or AWS_API_KEY_BEDROCK — either name is read
# AWS_REGION=us-east-1
# BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Comma-separated origins for a deployed frontend. localhost is always allowed.
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
