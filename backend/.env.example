# Supabase -> Project Settings -> Database -> Connection string -> URI
# MUST be port 5432 (direct/session). Port 6543 is the transaction pooler and
# has no prepared-statement support; the LangGraph checkpointer breaks on it.
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.ywtmxqwshajtdmpfbwiv.supabase.co:5432/postgres

APPROVAL_THRESHOLD_INR=150000
EMERGENCY_BUDGET_INR=500000
MAX_TOOL_CALLS_PER_INCIDENT=12
CLOCK_SECONDS_PER_SIM_HOUR=1

# Phase 4. Gemini only for now - do NOT wire Bedrock.
GEMINI_API_KEY=
